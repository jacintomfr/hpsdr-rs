+	/* libftd2xx's blocking FT_Read busy-polls (clock_gettime + mutex, no sleeping) while it
+	 * waits for data, which keeps a whole CPU core at 100%. Wait for the data ourselves with
+	 * short sleeps, then read what is already queued. Gives up after 1 s (the FT_SetTimeouts
+	 * value) and lets FT_Read report the timeout, so error handling is unchanged. */
+	{
