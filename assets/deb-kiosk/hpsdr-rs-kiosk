#!/bin/sh
# Starts hpsdr-rs in 1024x600 kiosk mode.
#
# Deliberately NO CPU pinning. An earlier version pinned the app to the cores
# reserved with isolcpus=..., which is a trap: the kernel does not load-balance
# between isolated cores, so every thread of the app (UI, DSP, RADE and the
# audio threads) landed on the same single core, saturated it and caused
# audio clicks. Remove isolcpus from the kernel command line instead and let
# the scheduler use all cores.
export HPSDR_LCD_1024X600=1
exec /usr/bin/hpsdr-rs "$@"
